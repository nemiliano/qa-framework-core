<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- BOM (Bill Of Materials): SOLO fija versiones. No trae dependencias por sí solo.
       Es standalone (sin parent) para que el parent pueda importarlo sin ciclos. -->
  <groupId>com.nemiliano.qa</groupId>
  <artifactId>qa-framework-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>QA Framework BOM</name>

  <!-- El BOM no tiene parent, así que declara su propio destino de publicación -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/nemiliano/qa-framework-core</url>
    </repository>
  </distributionManagement>

  <properties>
    <!-- Versiones verificadas en Maven Central (2026-10-07). Solo estables. -->
    <junit.version>6.1.3</junit.version>
    <selenium.version>4.50.0</selenium.version>
    <playwright.version>1.63.0</playwright.version>
    <assertj.version>3.27.7</assertj.version>
    <allure.version>2.35.5</allure.version>
    <log4j.version>2.26.1</log4j.version>
    <slf4j.version>2.0.20</slf4j.version>
    <rest-assured.version>6.0.1</rest-assured.version>
    <owner.version>1.0.12</owner.version>
    <jackson.version>2.22.3</jackson.version>
    <commons-csv.version>1.14.1</commons-csv.version>
    <datafaker.version>2.7.0</datafaker.version>
    <hikari.version>7.1.0</hikari.version>
    <h2.version>2.5.252</h2.version>
    <awaitility.version>4.3.0</awaitility.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BOMs de terceros -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>${log4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-bom</artifactId>
        <version>${allure.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Librerías sueltas -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.aeonbits.owner</groupId>
        <artifactId>owner</artifactId>
        <version>${owner.version}</version>
      </dependency>
      <dependency>
        <groupId>org.seleniumhq.selenium</groupId>
        <artifactId>selenium-java</artifactId>
        <version>${selenium.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microsoft.playwright</groupId>
        <artifactId>playwright</artifactId>
        <version>${playwright.version}</version>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured</artifactId>
        <version>${rest-assured.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-csv</artifactId>
        <version>${commons-csv.version}</version>
      </dependency>
      <dependency>
        <groupId>net.datafaker</groupId>
        <artifactId>datafaker</artifactId>
        <version>${datafaker.version}</version>
      </dependency>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${hikari.version}</version>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${h2.version}</version>
      </dependency>

      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${awaitility.version}</version>
      </dependency>

      <!-- Módulos propios del framework -->
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-data</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-db</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-files</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-reporting</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-ui-selenium</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-ui-playwright</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-junit-extensions</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
