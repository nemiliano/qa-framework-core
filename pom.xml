<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nemiliano.qa</groupId>
  <artifactId>qa-framework-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>QA Framework Parent</name>

  <modules>
    <module>bom</module>
    <module>core</module>
    <module>reporting</module>
    <module>ui-selenium</module>
    <module>ui-playwright</module>
    <module>junit-extensions</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Bytecode Java 17: compila con el JDK 25 pero corre en proyectos con Java 17+ (ADR-0001) -->
    <maven.compiler.release>17</maven.compiler.release>
    <surefire.version>3.6.0</surefire.version>
    <spotless.version>3.10.3</spotless.version>
    <!-- Los tests que abren navegador llevan @Tag("browser") y se excluyen por defecto.
         Para correrlos: mvnw verify -DexcludedGroups=none -->
    <excludedGroups>browser</excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.nemiliano.qa</groupId>
        <artifactId>qa-framework-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Dependencias comunes de TEST para todos los módulos -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <excludedGroups>${excludedGroups}</excludedGroups>
            <systemPropertyVariables>
              <headless>true</headless>
              <evidence.dir>${project.build.directory}/evidence</evidence.dir>
              <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <!-- Falla el build si el código no está formateado. Arreglo: mvn spotless:apply -->
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
